{
  "name": "@forge-ui/forms",
  "version": "0.1.0",
  "description": "Smart form components with Zod validation, react-hook-form integration, and React Query hooks — built on @forge-ui/react",
  "main": "dist/cjs/index.js",
  "module": "dist/esm/index.js",
  "types": "dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js"
    },
    "./styles.css": "./src/styles/globals.css"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "src/styles/globals.css"
  ],
  "scripts": {
    "build": "rollup -c rollup.config.mjs && tsc --project tsconfig.build.json --emitDeclarationOnly",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "storybook": "storybook dev -p 6008",
    "build-storybook": "storybook build",
    "lint": "eslint src --ext .ts,.tsx",
    "prepublishOnly": "rollup -c rollup.config.mjs && tsc --project tsconfig.build.json --emitDeclarationOnly"
  },
  "peerDependencies": {
    "@forge-ui/react": "^0.1.0",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0",
    "tailwindcss": "^3.3.0"
  },
  "devDependencies": {
    "@rollup/plugin-alias": "^6.0.0",
    "@rollup/plugin-terser": "^0.4.4",
    "@rollup/plugin-typescript": "^11.1.6",
    "@storybook/addon-a11y": "^8.4.0",
    "@storybook/addon-essentials": "^8.4.0",
    "@storybook/react": "^8.4.0",
    "@storybook/react-vite": "^8.4.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.6.0",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitest/coverage-v8": "^2.1.0",
    "autoprefixer": "^10.4.20",
    "jsdom": "^25.0.0",
    "lucide-react": "^0.576.0",
    "postcss": "^8.4.49",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "rollup": "^4.28.0",
    "rollup-plugin-peer-deps-external": "^2.2.4",
    "storybook": "^8.4.0",
    "storybook-dark-mode": "^4.0.2",
    "tailwindcss": "^3.4.0",
    "tailwindcss-animate": "^1.0.7",
    "tslib": "^2.8.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0",
    "@forge-ui/react": "^0.1.0"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.0.0",
    "react-hook-form": "^7.54.0",
    "@hookform/resolvers": "^5.2.0",
    "zod": "^3.23.0 || ^4.0.0",
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.5.0"
  },
  "license": "MIT",
  "author": "oluwatobimaxwell <tobisholanke@gmail.com>",
   "repository": {
    "type": "git",
    "url": "https://github.com/oluwatobimaxwell/libraries-project",
    "directory": "packages/forms"
  },
  "keywords": [
    "react",
    "forms",
    "react-hook-form",
    "zod",
    "validation",
    "tailwind"
  ],
  "publishConfig": {
    "access": "public"
  }
}
